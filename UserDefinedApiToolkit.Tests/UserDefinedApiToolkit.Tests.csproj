<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<PlatformTarget>x86</PlatformTarget>
		<LangVersion>latest</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- The Build project (and its transitive dependencies, e.g. Microsoft.OpenApi,
		     System.Reflection.MetadataLoadContext, ...) pull in NuGet packages that don't share
		     the exact same assembly versions used elsewhere in this net48 test project. Without
		     generated binding redirects, some CI test hosts (e.g. the Linux/Mono runner used by
		     our GitHub Actions pipeline) fail to unify these at runtime with errors like
		     MissingMethodException, even though the same code runs fine locally. -->
		<AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
		<GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="FluentAssertions" />
		<PackageReference Include="PublicApiGenerator" />
		<PackageReference Include="Verify.MSTest" />
		<PackageReference Include="MSTest" />
		<PackageReference Include="Skyline.DataMiner.Utils.DOM" />
		<PackageReference Include="Microsoft.Build.Utilities.Core" />
		<PackageReference Include="Microsoft.OpenApi" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="$(RootDir)\UserDefinedApiToolkit\UserDefinedApiToolkit.csproj" />
		<ProjectReference Include="$(RootDir)\UserDefinedApiToolkit.Build\UserDefinedApiToolkit.Build.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Reference Include="System.Web" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
	</ItemGroup>

</Project>
